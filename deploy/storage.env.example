# Environment untuk provisioning storage multi-provider.
# Salin ke /etc/nextcloud-storage.env (chmod 640, root:www-data) dan/atau
# environment php-fpm/php -S untuk backend website.
#
# minio (provider type s3-admin — opsional, legacy)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Cloudflare R2 — produk < 500 GB (type: cloudflare)
# Dibutuhkan backend (untuk hostname mount) DAN script provisioning.
R2_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opsional: override endpoint S3 (default: https://<account-id>.r2.cloudflarestorage.com)
R2_S3_HOSTNAME=
# R2_PATH_STYLE=0 untuk virtual-hosted style (default: path-style)
# R2_PATH_STYLE=

# Backblaze B2 — produk >= 500 GB (type: b2)
B2_KEY_ID=
B2_APP_KEY=
# Opsional:
# B2_API_URL=https://api.backblazeb2.com
# B2_S3_HOSTNAME=s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004

# Endpoint refresh spec untuk cron (sama dengan FOSSBILLING_ADMIN_TOKEN backend)
STORAGE_REFRESH_TOKEN=
SITE_URL=http://127.0.0.1:8001
NC_DIR=/home/danijh/Projects/nextcloud
MC=/usr/local/bin/mc
